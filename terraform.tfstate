            "user_data": "#!/bin/bash\n\nset -euxo pipefail\nexec \u003e \u003e(tee /var/log/bootstrap.log)\nexec 2\u003e\u00261\n\nyum update -y\n\ndnf install -y \\\n    postgresql18.aarch64 \\\n    unzip \\\n    git \\\n    jq \\\n    curl --allowerasing\n\ndnf install -y yum-utils\nyum-config-manager --add-repo https://rpm.releases.hashicorp.com/AmazonLinux/hashicorp.repo\ndnf install -y terraform\n\nmkdir -p /tmp/dvdrental\n\ncd /tmp/dvdrental\n\ncurl -L -o dvdrental.zip https://neon.tech/postgresqltutorial/dvdrental.zip\n\nunzip -o dvdrental.zip\n\nexport PGPASSWORD='Super$ecretPassw0rd'\n\npg_restore \\\n  --host=aurora-source.cluster-cjwgq0wq2ukk.eu-west-2.rds.amazonaws.com \\\n  --port=5432 \\\n  --username=postgres \\\n  --dbname=dvdrental \\\n  --verbose \\\n  dvdrental.tar",
            "user_data_base64": null,
            "user_data_replace_on_change": false,
            "volume_tags": null,
            "vpc_security_group_ids": [
              "sg-0749d2578d88b84d0"
            ]
          },
